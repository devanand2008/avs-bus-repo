# Primary: Supabase Postgres server connection, not the browser anon API key.
DATABASE_MODE=supabase
# Optional private Postgres schema (deployed project uses college_fleet).
DATABASE_SCHEMA=
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Explicit fallback: set DATABASE_MODE=mysql and fill the following URL. Never auto-switch after writes.
MYSQL_DATABASE_URL=mysql+pymysql://fleet:CHANGE_ME@127.0.0.1:3306/college_fleet?charset=utf8mb4
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENVIRONMENT=development
BOOTSTRAP_EMAIL=admin@yourcollege.edu
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_12_CHARACTER_PASSWORD
COLLEGE_NAME=AVS Engineering College
COLLEGE_SHORT_NAME=AVSEC
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
COOKIE_SECURE=false
MFA_REQUIRED=false
MFA_ENABLED=true
# Vercel runtime: true; use Supabase transaction pooler and private database evidence.
SERVERLESS=false
CRON_SECRET=
EVIDENCE_STORAGE=local
REDIS_URL=redis://localhost:6379/0
GPS_PROVIDER_URL=
GPS_PROVIDER_TOKEN=
GPS_WEBHOOK_SECRET=
PRIVATE_STORAGE_DIR=private-evidence
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
MAP_ATTRIBUTION=© OpenStreetMap contributors
